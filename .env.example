# Optional with Node 22/24: node --env-file=.env mcp/src/cli.mjs --transport http
THINKINGMODELS_API_BASE_URL=https://thinkingmodels.site
THINKINGMODELS_TIMEOUT_MS=10000
THINKINGMODELS_HTTP_HOST=127.0.0.1
THINKINGMODELS_HTTP_PORT=3000
# Required when listening on a non-loopback interface. Set a random secret locally.
# THINKINGMODELS_MCP_TOKEN=<YOUR_RANDOM_SECRET>
# THINKINGMODELS_ALLOWED_HOSTS=localhost,127.0.0.1,mcp.example.com
# THINKINGMODELS_ALLOWED_ORIGINS=https://mcp.example.com
